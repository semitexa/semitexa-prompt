{
    "name": "semitexa/prompt",
    "description": "Prompt catalog for the Semitexa Framework \u2014 discoverable prompt templates, variable binding, partial composition and render/inspect tooling (an ORM for prompts)",
    "type": "semitexa-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Semitexa",
            "email": "support@semitexa.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "semitexa/core": ">=2026.11.23.0659 || dev-master",
        "semitexa/orm": "*",
        "twig/twig": "^3.28",
        "semitexa/update": ">=2026.11.15.0920 || dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Semitexa\\Prompt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Semitexa\\Prompt\\Tests\\": "tests/"
        }
    },
    "extra": {
        "semitexa-module": {
            "name": "prompt",
            "description": "Prompt catalog: discoverable prompt templates, variable binding, partial composition and render/inspect CLI"
        },
        "semitexa": {
            "floors": {
                "semitexa/update": "2026.11.15.0920",
                "semitexa/core": "2026.11.23.0659"
            }
        }
    },
    "keywords": [
        "semitexa",
        "prompt",
        "llm",
        "ai",
        "template",
        "catalog"
    ]
}
